# ─── Railway 배포 시 환경변수 설정 ───
# Railway 대시보드 > Variables 에서 아래 값들을 설정하세요

NODE_ENV=production
PORT=3000

# PostgreSQL (Railway에서 Postgres 플러그인 추가하면 자동 설정됨)
DATABASE_URL=postgresql://postgres:password@host:5432/railway
DB_HOST=
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=railway

# Redis (Railway에서 Redis 플러그인 추가하면 자동 설정됨)
REDIS_URL=redis://default:password@host:6379
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=emba-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=emba-refresh-secret-change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# 카카오 알림톡 (선택)
KAKAO_REST_API_KEY=
KAKAO_ALIMTALK_SENDER_KEY=
KAKAO_ALIMTALK_PHONE=

# Google Calendar (선택)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN.up.railway.app/api/v1/calendar/callback
